{
  "components": {
    "schemas": {
      "ChatMessage": {
        "description": "Eine Chat-Nachricht (Rolle + Textinhalt).",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatRequest": {
        "description": "Eingabe des ``/gateway/chat``-Endpunkts.",
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResult": {
        "description": "Normalisiertes Ergebnis eines Chat-Aufrufs – providerunabhängig.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "content",
          "usage",
          "latency_ms",
          "provider",
          "model"
        ],
        "title": "ChatResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelSummary": {
        "description": "Aggregierte Kennzahlen eines Modells im Zeitfenster.",
        "properties": {
          "calls": {
            "title": "Calls",
            "type": "integer"
          },
          "completion_tokens": {
            "title": "Completion Tokens",
            "type": "integer"
          },
          "cost_estimate": {
            "title": "Cost Estimate",
            "type": "number"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "prompt_tokens": {
            "title": "Prompt Tokens",
            "type": "integer"
          },
          "total_tokens": {
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "required": [
          "model",
          "calls",
          "prompt_tokens",
          "completion_tokens",
          "total_tokens",
          "cost_estimate"
        ],
        "title": "ModelSummary",
        "type": "object"
      },
      "SummaryResponse": {
        "description": "Antwort des Summary-Endpunkts.",
        "properties": {
          "days": {
            "title": "Days",
            "type": "integer"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelSummary"
            },
            "title": "Models",
            "type": "array"
          },
          "since": {
            "format": "date-time",
            "title": "Since",
            "type": "string"
          }
        },
        "required": [
          "days",
          "since",
          "models"
        ],
        "title": "SummaryResponse",
        "type": "object"
      },
      "Usage": {
        "description": "Token-Verbrauch eines Aufrufs (Grundlage der Kostentelemetrie, #7).",
        "properties": {
          "completion_tokens": {
            "title": "Completion Tokens",
            "type": "integer"
          },
          "prompt_tokens": {
            "title": "Prompt Tokens",
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens"
        ],
        "title": "Usage",
        "type": "object"
      },
      "User": {
        "description": "Der authentifizierte Nutzer mit einer Rolle (Admin/User/Auditor).",
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "role"
        ],
        "title": "User",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "stellwerk-core",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/gateway/chat": {
      "post": {
        "description": "Führt einen Chat-Aufruf über den konfigurierten Provider aus.",
        "operationId": "chat_api_v1_gateway_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat",
        "tags": [
          "gateway"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "Gibt den aktuell authentifizierten Nutzer zurück (DevAuth in v0.1).",
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me"
      }
    },
    "/api/v1/telemetry/summary": {
      "get": {
        "description": "Summen je Modell über die letzten ``days`` Tage.",
        "operationId": "summary_api_v1_telemetry_summary_get",
        "parameters": [
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 7,
              "maximum": 365,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Summary",
        "tags": [
          "telemetry"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness: reine Prozess-Antwort, keine Abhängigkeiten.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Rendert die Default-Registry im Prometheus-Textformat.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics",
        "tags": [
          "telemetry"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness: 200 nur bei erreichbarer DB (``SELECT 1``), sonst 503.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    }
  }
}
