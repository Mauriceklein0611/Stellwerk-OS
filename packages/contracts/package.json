{
  "name": "@stellwerk/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Aus dem Kern-OpenAPI generierte TypeScript-Typen (Vertrag).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "openapi.json"],
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.ts",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
