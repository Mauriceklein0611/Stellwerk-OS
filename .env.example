# Stellwerk – Beispiel-Umgebung.
# Kopieren nach .env (wird von Git ignoriert, niemals committen).

# --- Core (services/core) ---
STW_APP_NAME=stellwerk-core
STW_ENV=dev
STW_LOG_LEVEL=INFO
# DevAuth-Rolle (ADR-007): admin | user | auditor
STW_DEV_ROLE=admin

# Persistenz (SQLAlchemy 2 + psycopg3)
# Lokal (uv run) gegen ein Host-Postgres. Im Compose-Netz überschreibt
# docker-compose.yml diesen Wert automatisch auf Host `postgres`.
STW_DATABASE_URL=postgresql+psycopg://stw:stw@localhost:5432/stellwerk

# --- Model Gateway (ADR-006) ---
# Aktiver Provider: stub (deterministisch, Default) | ollama
STW_GATEWAY_PROVIDER=stub
# Erlaubte Modelle (CSV, Allowlist)
STW_GATEWAY_MODELS=stub-echo,llama3.2
# Ollama-Server (nur für Provider=ollama; im Compose-llm-Profil gesetzt)
STW_OLLAMA_URL=http://localhost:11434

# --- Postgres & Ports (docker-compose) ---
# Zugangsdaten des Compose-Postgres; die Container-DB-URL wird daraus gebaut.
POSTGRES_USER=stw
POSTGRES_PASSWORD=stw
POSTGRES_DB=stellwerk
# Host-Ports (nach außen veröffentlicht); bei Konflikten hier anpassen.
POSTGRES_PORT=5432
CORE_PORT=8000
OLLAMA_PORT=11434
PMS_PORT=3000

# --- Monitoring (Profil monitoring) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
# Anonymes Lesen der Dashboards (true/false)
GRAFANA_ANON_ENABLED=true

# Nur für DB-Tests (services/core): wird gesetzt, laufen die DB-Tests gegen
# dieses Postgres; ungesetzt werden sie übersprungen (Unit-Suite bleibt Docker-frei).
# STW_TEST_DATABASE_URL=postgresql+psycopg://stw:stw@localhost:5432/stellwerk_test
