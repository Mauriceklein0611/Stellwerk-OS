# Stellwerk – Beispiel-Umgebung.
# Kopieren nach .env (wird von Git ignoriert, niemals committen).

# --- Core (services/core) ---
STW_APP_NAME=stellwerk-core
STW_ENV=dev
STW_LOG_LEVEL=INFO
# DevAuth-Rolle (ADR-007): admin | user | auditor
STW_DEV_ROLE=admin

# Persistenz (SQLAlchemy 2 + psycopg3)
STW_DATABASE_URL=postgresql+psycopg://stw:stw@localhost:5432/stellwerk

# Nur für DB-Tests (services/core): wird gesetzt, laufen die DB-Tests gegen
# dieses Postgres; ungesetzt werden sie übersprungen (Unit-Suite bleibt Docker-frei).
# STW_TEST_DATABASE_URL=postgresql+psycopg://stw:stw@localhost:5432/stellwerk_test
